# Google Gemini API Key (Required for AI Deep Dive & Daily Sentinel analysis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Tavily API Key (Optional - falls back to DuckDuckGo Search if empty)
TAVILY_API_KEY=your_tavily_api_key_here

# Scalable Capital CLI Command (Optional - defaults to "sc" from ScalableCapital/scalable-cli)
SCALABLE_CLI_CMD=sc

# Optional Caching & Alert Settings
CACHE_TTL_HOURS=24
SENTINEL_DEFAULT_THRESHOLD_PCT=5.0
